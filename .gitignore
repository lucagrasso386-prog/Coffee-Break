# Flutter/Dart (see mobile/.gitignore for the mobile/ subtree specifics --
# generated android/, ios/, and other platform folders live there, not here)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/

# Backend (Node/TypeScript)
backend/node_modules/
backend/dist/
backend/.env
backend/*.log
backend/prisma/*.db
