# Provided automatically by Railway's Postgres plugin once attached.
DATABASE_URL=postgresql://user:password@localhost:5432/coffee_break

# Secret used to sign the app's own session JWTs. Generate a long random value.
JWT_SECRET=

# Your app's Bundle ID from Apple Developer / App Store Connect (used as the
# "aud" claim when verifying Sign in with Apple identity tokens).
APPLE_BUNDLE_ID=com.lucagiraud.coffeebreak

# App Store Connect API key (In-App Purchase key type), for server-side
# receipt validation. See src/lib/appStoreServer.ts.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# OAuth 2.0 client ID from Google Cloud Console (used as the "aud" claim
# when verifying Sign in with Google id tokens). See src/lib/googleAuth.ts
# and docs/SETUP.md for how to create it.
GOOGLE_CLIENT_ID=

PORT=3000
NODE_ENV=development
